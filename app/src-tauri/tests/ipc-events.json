{
  "vaultChanged": {
    "name": "vault://changed",
    "payload": {
      "fields": { "path": "path", "kind": "kind" },
      "kinds": { "created": "created", "modified": "modified", "removed": "removed" }
    }
  },
  "bfwNotes": {
    "name": "bfworkflow://notes",
    "payload": {
      "fields": { "requestId": "requestId", "step": "step", "message": "message" }
    }
  },
  "mcpCall": {
    "name": "mcp://call",
    "payload": {
      "fields": { "callId": "callId", "name": "name", "args": "args", "mutates": "mutates" }
    }
  },
  "mcpCancel": {
    "name": "mcp://cancel",
    "payload": {
      "fields": { "callId": "callId" }
    }
  }
